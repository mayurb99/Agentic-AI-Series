# Copy this file to ".env" in the same folder and fill in your real key.
# NEVER commit the real ".env" file — it is already listed in .gitignore.

# Required for all three demos (Demo 1 uses bind_tools; Demos 2–3 use create_agent).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
