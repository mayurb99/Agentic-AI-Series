# Copy this file to ".env" in the same folder and fill in your real key.
# NEVER commit the real ".env" file — it is already listed in .gitignore.

# Required for all 4 demos. Get a free key at https://console.groq.com/keys
# This DevOps track uses Groq exclusively for every lecture -- from this
# lecture onward, it's accessed through LangChain's ChatGroq instead of
# the raw groq SDK, but it's still the same Groq account and key.
GROQ_API_KEY=your_groq_api_key_here
